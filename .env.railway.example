# Set these as Railway service variables (Project → Service → Variables).
# Do NOT commit real values — this file only documents which keys are needed.
# Railway auto-injects PORT; do not set it yourself.

# ── Supabase (Cloud) ──────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

# ── Auth secrets ──────────────────────────────────────────────
SUPPORT_JWT_SECRET=
CLIENT_STAFF_JWT_SECRET=
CLIENT_DASHBOARD_JWT_SECRET=
LOCAL_NODE_API_KEY=
STREAM_TOKEN_SECRET=

# ── Third-party ───────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Runtime ───────────────────────────────────────────────────
FLASK_ENV=production
PYTHONUNBUFFERED=1
ENABLE_GPU=false
LOG_LEVEL=INFO

# NOT needed on Railway (these were for the Windows local_node component):
#   NODE_ID, ORG_ID, BRANCH_ID, SYNC_POLL_INTERVAL,
#   SYNC_ATTENDANCE_BATCH_SIZE, NODE_INSTALLER_EXE_PATH
# RAILWAY_API_BASE_URL — set this to your deployed backend's own public
# URL once you have it, since local_node/trainer_desktop use it to call in.
